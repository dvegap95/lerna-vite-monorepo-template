{
  "name": "@monorepo/root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "init:monorepo": "node scripts/init-monorepo.mjs",
    "use:external-package": "node scripts/use-external-package.mjs",
    "enable:github-template": "node scripts/enable-github-template.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && yarn install",
    "release:packages": "yarn build && changeset publish",
    "start:common-lib": "lerna run --scope @monorepo/common-lib storybook --stream",
    "start:mui-stack": "lerna run --scope @monorepo/example-mui-stack storybook --stream",
    "build:common-lib": "lerna run --scope @monorepo/common-lib build --stream",
    "test:common-lib": "lerna run --scope @monorepo/common-lib test --stream",
    "dev:example-app": "lerna run --scope @monorepo/example-app dev --stream",
    "start:example-app": "lerna run --scope @monorepo/example-app start --stream",
    "build": "lerna run build --stream",
    "test": "lerna run test --stream",
    "lint": "eslint .",
    "lint:ci": "yarn lint",
    "test:ui": "cross-env NODE_ENV=test vitest --ui --coverage",
    "test:diff": "cross-env NODE_ENV=test node ./scripts/test-git-changes.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static -p 6006 -a --silent\" \"wait-on tcp:6006 && test-storybook --url http://127.0.0.1:6006\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/poppins": "^5.2.6",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@chromatic-com/storybook": "^3.2.6",
    "@emotion/babel-plugin": "^11.13.5",
    "@storybook/addon-essentials": "^8.6.7",
    "@storybook/addon-interactions": "^8.6.7",
    "@storybook/addon-links": "^8.6.7",
    "@storybook/addon-onboarding": "^8.6.7",
    "@storybook/blocks": "^8.6.7",
    "@storybook/react": "^8.6.7",
    "@storybook/react-vite": "^8.6.7",
    "@storybook/test": "^8.6.7",
    "@storybook/test-runner": "^0.22.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-spellcheck": "^0.0.20",
    "eslint-plugin-storybook": "^0.11.6",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lerna": "^8.2.1",
    "lint-staged": "^15.5.0",
    "playwright": "^1.51.0",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "storybook": "^8.6.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-live-preview": "^0.1.4",
    "vite-plugin-turbosnap": "^1.0.3",
    "vitest": "^4.1.8",
    "vitest-preview": "^0.0.1",
    "wait-on": "^8.0.3"
  }
}
